# 复制为 server/.env 并填写（.env 不提交到 git）

# PostgreSQL 连接串（本地 Homebrew PG 17）
# 格式：postgresql://<用户>:<密码>@127.0.0.1:5432/<库名>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/contract_seal?schema=public"

# 服务端口
PORT=7001

# JWT 密钥（阶段 4 登录用，先占位）
JWT_SECRET="change-me-in-production"

# 附件私有目录（本地私有存储）
FILE_STORAGE_DIR="./storage/files"

# 签名 URL 有效期（秒）
DOWNLOAD_URL_TTL_SECONDS=300